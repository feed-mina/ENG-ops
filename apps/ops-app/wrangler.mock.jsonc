{
  "name": "harmony-ops-mock",
  "main": "src/index.js",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DATA_MODE": "mock",
    "INTAKE_ENABLED": "false",
    "SDUI_ENABLED": "false",
    "SDUI_REVISION": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harmony-ops-mock",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
