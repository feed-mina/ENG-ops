{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmony-job-center.invalid/schemas/harmony.sdui.capabilities.v1.schema.json",
  "title": "Harmony SDUI Renderer Capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rendererVersion", "surface", "schemas", "components", "actions", "formatters"],
  "properties": {
    "schema": { "const": "harmony.sdui.capabilities.v1" },
    "rendererVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
    },
    "surface": { "enum": ["web", "mobile"] },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
      }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]{0,79}$" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "actions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "formatters": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    }
  }
}
