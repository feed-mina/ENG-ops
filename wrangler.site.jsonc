{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 비공개 내부 사이트(정적 Mock UI + ops-web 번들) 배포 설정.
  // dist/server/index.js 는 `npm run build` 가 생성하므로 배포 전에 반드시 빌드한다.
  // 이미 배포된 Worker 이름이 다르면 name 을 기존 배포와 동일하게 맞춘 뒤 사용한다.
  // 이 Worker 는 Cloudflare Access 뒤에서만 노출한다 — Access 없이 공개 route 를 붙이지 않는다.
  "name": "harmony-ops-site",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "preview_urls": false,
  "services": [
    {
      "binding": "OPS_API",
      "service": "harmony-ops-staging"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
